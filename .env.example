# Defaults preserve the current v3 production feed.
REACT_APP_HAZZAT_CONTENT_VERSION=v3

# Optional content origin/prefix overrides. The requested /v3 or /v4 path is
# appended to the base, so do not include the version itself here.
# REACT_APP_HAZZAT_CONTENT_BASE_URL=https://your-content-origin.example/rehearsal
# REACT_APP_HAZZAT_DEV_CONTENT_BASE_URL=https://your-dev-content-origin.example
# REACT_APP_HAZZAT_PPE_CONTENT_BASE_URL=https://your-ppe-content-origin.example
# REACT_APP_HAZZAT_PROD_CONTENT_BASE_URL=https://your-production-content-origin.example

# Explicit ETag requests require CloudFront to expose ETag and allow
# If-None-Match in CORS. Browser HTTP caching still works with this disabled.
REACT_APP_HAZZAT_CONTENT_ETAGS=false
